# Local development: copy this file to .env inside backend/.
# Get the development MongoDB URI and app-admin login privately from the owner.
# Never commit credentials. Do not use production accounts or data here.
PORT=4005
MONGO_URI=

# Only needed by npm run seed:admin when creating an admin in a new database.
# For an existing shared database, use the supplied app login; no seed is needed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generate your own local signing secrets with npm run create:secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REFRESH_RATE_LIMIT_WINDOW=60000
REFRESH_RATE_LIMIT_MAX=5

# Number of proxies in front of Express, so rate limits see each visitor's real
# IP instead of the proxy's. Local (browser -> next dev -> backend): 1.
# Production on Render with the /api/proxy rewrite (browser -> Render -> Next ->
# Render -> backend): 2. Without the rewrite (browser -> Render -> backend): 1.
# Too high lets clients fake their IP; too low makes every visitor share one limit.
TRUST_PROXY=1

# Deployed frontend URL(s) allowed to call the API, comma-separated, no trailing
# slash - e.g. https://krishya.in,https://www.krishya.in. Localhost on any port
# is always allowed outside production, so this can stay empty locally.
CORS_ORIGINS=

# Required for backend image operations. Use development Cloudinary credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments are optional for non-checkout work. Use your own Razorpay test account.
# Keep this in sync with NEXT_PUBLIC_PAYMENT_MODE in frontend-next/.env.
# Without test keys, the server can start but payment operations are unavailable.
PAYMENT_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Only needed when testing Razorpay webhooks; use your test webhook's secret.
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp and Resend credentials are intentionally omitted for onboarding.
# Resend email delivery is skipped without its API key; WhatsApp sends are
# currently commented out. No SMTP or OpenAI configuration is used by the app.
