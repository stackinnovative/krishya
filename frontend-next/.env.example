# Local development: copy this file to .env inside frontend-next/.
# Start the backend on port 4005. Browser requests use the same-origin proxy.
NEXT_PUBLIC_API_BASE_URL=/api/proxy
BACKEND_API_URL=http://localhost:4005/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for image uploads. Use a development cloud and unsigned upload preset.
# The cloud name should match the backend's Cloudinary environment.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Use your own Razorpay test account. Copy the same test key ID to
# RAZORPAY_TEST_KEY_ID in backend/.env; the secret belongs ONLY in the backend.
# Checkout requires these test credentials; other work can leave the ID blank.
NEXT_PUBLIC_PAYMENT_MODE=test
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID=

# Optional public contact details displayed by the storefront.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_FACEBOOK_URL=
# Optional storefront details (Krishay Ayurveda). Shown in the footer, product
# pages and contact page only when set.
NEXT_PUBLIC_AYUSH_LICENSE_NO=
NEXT_PUBLIC_STORE_ADDRESS=
